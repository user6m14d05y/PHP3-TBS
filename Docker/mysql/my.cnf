[mysqld]
# ═══════════════════════════════════════════════════════
# MySQL 8 Performance Tuning — Docker dev environment
# ═══════════════════════════════════════════════════════

# ─── InnoDB Buffer Pool ───────────────────────────────
# Nơi MySQL cache data + index trong RAM
# Tăng từ 128MB default lên 256MB → giảm I/O đọc từ disk
innodb_buffer_pool_size = 256M

# Chia pool thành 2 instances → concurrent access tốt hơn
innodb_buffer_pool_instances = 2

# ─── InnoDB I/O ───────────────────────────────────────
# Log file lớn hơn → batch ghi lớn hơn, ít flush hơn
innodb_log_file_size = 128M

# Flush log mỗi giây thay vì mỗi transaction
# (chấp nhận mất ~1s data nếu crash → OK với dev)
innodb_flush_log_at_trx_commit = 2

# Tăng số I/O threads để tận dụng SSD
innodb_read_io_threads = 4
innodb_write_io_threads = 4

# Flush method tốt nhất cho Linux/WSL
innodb_flush_method = O_DIRECT

# ─── Query Cache (tắt — deprecated MySQL 8) ──────────
# Query cache gây lock tranh chấp, không còn hiệu quả
query_cache_type = 0
query_cache_size = 0

# ─── Connection & Thread ──────────────────────────────
max_connections = 100
thread_cache_size = 8

# ─── Replication (tắt cho dev) ───────────────────────
skip-log-bin

# ─── Sort & Join buffers ──────────────────────────────
sort_buffer_size = 4M
join_buffer_size = 4M

# ─── Table cache ──────────────────────────────────────
table_open_cache = 400
table_definition_cache = 400

# ─── Tắt performance_schema để tiết kiệm RAM (~100MB) ─
performance_schema = OFF

# ─── Timeout ──────────────────────────────────────────
wait_timeout = 300
interactive_timeout = 300
