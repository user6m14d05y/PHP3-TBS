[mysqld]
# === Performance Tuning cho Docker ===

# Buffer pool — nơi MySQL cache data + index trong RAM
# Tăng từ default 128MB lên 256MB giúp giảm I/O đọc từ disk
innodb_buffer_pool_size = 256M

# Log file size — cho phép batch ghi lớn hơn, giảm số lần flush
innodb_log_file_size = 64M

# Flush log mỗi giây thay vì mỗi transaction — tăng tốc INSERT/UPDATE
innodb_flush_log_at_trx_commit = 2

# Tắt binary log (không cần replication cho dev)
skip-log-bin

# Tăng số connection đồng thời
max_connections = 100

# Buffer cho sort & join operations
sort_buffer_size = 4M
join_buffer_size = 4M

# Table cache — giảm số lần mở file
table_open_cache = 200

# Tắt performance_schema để tiết kiệm RAM (~100MB)
performance_schema = OFF
